{
  "name": "medication-reminder-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "//--- CORE COMMANDS ---//": "",
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --tsc --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "//--- INDIVIDUAL SERVICES (DEV) ---//": "",
    "dev:account": "nest start account-service --webpack --webpackPath webpack-hmr.config.js --watch",
    "dev:scheduling": "nest start scheduling-service --webpack --webpackPath webpack-hmr.config.js --watch",
    "dev:notification": "nest start notification-service --webpack --webpackPath webpack-hmr.config.js --watch",
    "dev:billing": "nest start billing-service --webpack --webpackPath webpack-hmr.config.js --watch",
    "dev:appointment": "nest start appointment-service --webpack --webpackPath webpack-hmr.config.js --watch",
    "dev:immunization": "nest start immunization-service --webpack --webpackPath webpack-hmr.config.js --watch",
    "dev:tenant-management": "nest start tenant-management-service --webpack --webpackPath webpack-hmr.config.js --watch",
    "dev:note": "nest start note-service --webpack --webpackPath webpack-hmr.config.js --watch",
    "dev:orchestrator": "nest start orchestrator-service --webpack --webpackPath webpack-hmr.config.js --watch",
    "//--- INDIVIDUAL SERVICES (DEV DOCKER) ---//": "",
    "dev:docker:account": "nest start account-service --tsc --watch --preserveWatchOutput",
    "dev:docker:scheduling": "nest start scheduling-service --tsc --watch --preserveWatchOutput",
    "dev:docker:notification": "nest start notification-service --tsc --watch --preserveWatchOutput",
    "dev:docker:billing": "nest start billing-service --tsc --watch --preserveWatchOutput",
    "dev:docker:appointment": "nest start appointment-service --tsc --watch --preserveWatchOutput",
    "dev:docker:immunization": "nest start immunization-service --tsc --watch --preserveWatchOutput",
    "dev:docker:tenant-management": "nest start tenant-management-service --tsc --watch --preserveWatchOutput",
    "dev:docker:note": "nest start note-service --tsc --watch --preserveWatchOutput",
    "dev:docker:orchestrator": "nest start orchestrator-service --tsc --watch --preserveWatchOutput",
    "//--- INDIVIDUAL SERVICES (PROD BUILD) ---//": "",
    "build:account": "nest build account-service",
    "build:scheduling": "nest build scheduling-service",
    "build:notification": "nest build notification-service",
    "build:billing": "nest build billing-service",
    "build:appointment": "nest build appointment-service",
    "build:immunization": "nest build immunization-service",
    "build:tenant-management": "nest build tenant-management-service",
    "build:note": "nest build note-service",
    "build:orchestrator": "nest build orchestrator-service",
    "//--- RUN ALL SERVICES (DEV) ---//": "",
    "dev": "concurrently --names \"ACCOUNT,SCHEDULING,NOTIFICATION,BILLING,APPOINTMENT,IMMUNIZATION\" -c \"bgBlue.bold,bgMagenta.bold,bgGreen.bold,bgCyan.bold,bgYellow.bold,bgRed.bold\" \"npm:dev:account\" \"npm:dev:scheduling\" \"npm:dev:notification\" \"npm:dev:billing\" \"npm:dev:appointment\" \"npm:dev:immunization\"",
    "//--- RUN ALL SERVICES (DEV ON DOCKER) ---//": "",
    "up:dev": "docker compose -f docker-compose.dev.yml -f docker-compose.yml -f docker-compose.infra.yml -f docker-compose.databases.yml -f docker-compose.services.yml up --build",
    "down:dev": "docker compose -f docker-compose.dev.yml -f docker-compose.yml -f docker-compose.infra.yml -f docker-compose.databases.yml -f docker-compose.services.yml down",
    "restart:dev": "npm run down:dev && npm run up:dev"
  },
  "dependencies": {
    "@apollo/server": "^4.12.2",
    "@golevelup/nestjs-rabbitmq": "^6.0.1",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/apollo": "^13.1.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.1.5",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.5",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/graphql": "^13.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.1.5",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.5",
    "@nestjs/platform-socket.io": "^11.1.5",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.5",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.8",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.1.1",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "firebase-admin": "^13.4.0",
    "google-auth-library": "^10.2.1",
    "graphql": "^16.11.0",
    "graphql-type-json": "^0.3.2",
    "libphonenumber-js": "^1.12.10",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "nodemailer": "^7.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.2.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.4.2",
    "run-script-webpack-plugin": "^0.2.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "webpack": "^5.101.2",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@app/api-clients(|/.*)$": "<rootDir>/libs/api-clients/src/$1",
      "^@app/auth(|/.*)$": "<rootDir>/libs/auth/src/$1",
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/outbox(|/.*)$": "<rootDir>/libs/outbox/src/$1",
      "^src/(.*)$": "<rootDir>/$1"
    },
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ]
  }
}
