{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "tsconfig.json"
  },
  "monorepo": true,
  "projects": {
    "account-service": {
      "type": "application",
      "root": "apps/account-service",
      "entryFile": "main",
      "sourceRoot": "apps/account-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/account-service/tsconfig.app.json",
        "webpack": true,
        "assets": [
          "apps/account-service/src/auth/templates/**/*"
        ]
      }
    },
    "api-clients": {
      "type": "library",
      "root": "libs/api-clients",
      "entryFile": "index",
      "sourceRoot": "libs/api-clients/src",
      "compilerOptions": {
        "tsConfigPath": "libs/api-clients/tsconfig.lib.json"
      }
    },
    "appointment-service": {
      "type": "application",
      "root": "apps/appointment-service",
      "entryFile": "main",
      "sourceRoot": "apps/appointment-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/appointment-service/tsconfig.app.json"
      }
    },
    "auth": {
      "type": "library",
      "root": "libs/auth",
      "entryFile": "index",
      "sourceRoot": "libs/auth/src",
      "compilerOptions": {
        "tsConfigPath": "libs/auth/tsconfig.lib.json"
      }
    },
    "billing-service": {
      "type": "application",
      "root": "apps/billing-service",
      "entryFile": "main",
      "sourceRoot": "apps/billing-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/billing-service/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "immunization-service": {
      "type": "application",
      "root": "apps/immunization-service",
      "entryFile": "main",
      "sourceRoot": "apps/immunization-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/immunization-service/tsconfig.app.json"
      }
    },
    "notification-service": {
      "type": "application",
      "root": "apps/notification-service",
      "entryFile": "main",
      "sourceRoot": "apps/notification-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification-service/tsconfig.app.json",
        "webpack": true,
        "assets": [
          {
            "include": "firebase-service-account.json",
            "outDir": "./"
          }
        ]
      }
    },
    "scheduling-service": {
      "type": "application",
      "root": "apps/scheduling-service",
      "entryFile": "main",
      "sourceRoot": "apps/scheduling-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/scheduling-service/tsconfig.app.json",
        "webpack": true
      }
    }
  }
}