{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/account-service/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true
  },
  "monorepo": true,
  "root": "apps/account-service",
  "projects": {
    "account-service": {
      "type": "application",
      "root": "apps/account-service",
      "entryFile": "main",
      "sourceRoot": "apps/account-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/account-service/tsconfig.app.json"
      }
    },
    "scheduling-service": {
      "type": "application",
      "root": "apps/scheduling-service",
      "entryFile": "main",
      "sourceRoot": "apps/scheduling-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/scheduling-service/tsconfig.app.json"
      }
    },
    "notification-service": {
      "type": "application",
      "root": "apps/notification-service",
      "entryFile": "main",
      "sourceRoot": "apps/notification-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification-service/tsconfig.app.json",
        "assets": [
          { "include": "firebase-service-account.json", "outDir": "./" }
        ]
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "api-clients": {
      "type": "library",
      "root": "libs/api-clients",
      "entryFile": "index",
      "sourceRoot": "libs/api-clients/src",
      "compilerOptions": {
        "tsConfigPath": "libs/api-clients/tsconfig.lib.json"
      }
    }
  }
}